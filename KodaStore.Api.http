@baseUrl = http://localhost:5231

GET {{baseUrl}}/weatherforecast/
Accept: application/json

### Get Product All
GET {{baseUrl}}/api/v1/products
Accept: application/json

### Get Product By Code
GET {{baseUrl}}/api/v1/products/PR01
Accept: application/json

### POST Product
POST {{baseUrl}}/api/v1/products
Accept: application/json
Content-Type: application/json

{
    "productCode": "PR05",
    "name": "Bakso Satelit",
    "price": 22000,
    "stock": 231,
    "category": "Bakso",
    "description": "Bakso isimewa dg tetelan daging"
}

### UPDATE DATA
PUT {{baseUrl}}/api/v1/products/PR04
Accept: application/json
Content-Type: application/json

{
    "name": "Bakso Urat",
    "price": 15000,
    "stock": 221,
    "category": "Bakso",
    "description": "Bakso pake urat sapi, rasa rada alot menggoda"
}
 
### Delete Product
DELETE {{baseUrl}}/api/v1/products/PR05
Accept: application/json

### Upload Gambar
POST {{baseUrl}}/api/v1/products/P002/image
Content-Type: multipart/form-data; boundary=KodaStore

--KodaStore
Content-Disposition: form-data; name="file"; filename="valid_product.jpg"
Content-Type: image/jpeg

< C:\Upload\valid_product.jpg
--KodaStore--


### Get Orders
GET {{baseUrl}}/api/v1/orders
Accept: application/json

### Get Orders by Id
GET {{baseUrl}}/api/v1/orders/1
Accept: application/json

### Update Confirm
PATCH {{baseUrl}}/api/v1/orders/3/confirm
Accept: application/json



### POST Order 
POST {{baseUrl}}/api/v1/orders
Accept: application/json
Content-Type: application/json

{
    "orderNumber": "ORD-003",
    "items": [
        {
            "productCode": "P001",
            "productName": "Keyboard Mekanik",
            "quantity": 4,
            "unitPrice": 35000.00,
            "subTotal": 140000.00
        },
        {
            "productCode": "P002",
            "productName": "Mouse",
            "quantity": 5,
            "unitPrice": 20000.00,
            "subTotal": 100000.00
        }
    ]
}
